# ============================================================
# Marketplace API Gateway — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# In production, inject these via your secrets manager
# (Docker secrets, Kubernetes Secrets, AWS Secrets Manager, etc.)
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Authentication ───────────────────────────────────────────
# Shared secret between api-gateway (verify) and auth-service (sign).
# Minimum 32 characters. Use a cryptographically random string.
# Generate: openssl rand -hex 64
JWT_SECRET=

# ── Redis ────────────────────────────────────────────────────
# Used for rate-limit counters and token blacklist.
REDIS_URL=redis://redis:6379

# ── Downstream Service URLs ───────────────────────────────────
# Use internal Docker/Kubernetes service names in production.
AUTH_SERVICE_URL=http://auth-service:3001
BACKEND_API_URL=http://backend-api:3002
PAYMENT_SERVICE_URL=http://payment-service:3003
REALTIME_SERVICE_URL=http://realtime-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
ALLOWED_ORIGINS=https://customer.marketplace.com,https://pro.marketplace.com,https://admin.marketplace.com

# ── Platform Identity ─────────────────────────────────────────
# Used only in headers (X-Platform), logs, and tracing.
# Never used inside routing or auth logic.
PLATFORM_NAME=Marketplace
PLATFORM_VERSION=v1
SERVICE_NAME=api-gateway

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

